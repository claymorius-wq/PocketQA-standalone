# Copy to .env.local (gitignored). Never commit real values.
# The API refuses to start unless HOST is a loopback address (127.0.0.1 or ::1).
POCKETQA_API_HOST=127.0.0.1
POCKETQA_API_PORT=8787
# The API refuses to start if this directory is inside the repo but not ignored by git.
POCKETQA_DATA_DIR=apps/api/.data
# Devnet only. The API refuses chain features unless the RPC genesis hash is devnet's.
POCKETQA_SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional AI provider. Leave it empty and the app shows "Analysis unavailable".
POCKETQA_AI_PROVIDER=

# ---- Cloud identity, wallet login and storage (ADR 0005; docs/deploy/cloud-backend.md) ----
# All off by default. Never put credentials in this file; server secrets come from the
# environment of the hosting platform (and GOOGLE_APPLICATION_CREDENTIALS for Firebase Admin).
# Managed identity: local (password sessions) or firebase.
POCKETQA_AUTH_MODE=local
# firebase mode: project id plus the *public* web config (shipped to browsers anyway).
POCKETQA_FIREBASE_PROJECT_ID=
POCKETQA_FIREBASE_WEB_API_KEY=
POCKETQA_FIREBASE_AUTH_DOMAIN=
# Local testing only, with a demo- project id: e.g. 127.0.0.1:9099 (refused otherwise).
POCKETQA_FIREBASE_AUTH_EMULATOR_HOST=
# Wallet-first login (off by default). Requires the app's exact public origin.
POCKETQA_WALLET_LOGIN=0
POCKETQA_PUBLIC_ORIGIN=
# development (default) or production. Production refuses local auth, the shared demo, emulators,
# demo- projects, local media, R2 retention-only mode and test credits; it needs an https
# POCKETQA_PUBLIC_ORIGIN and a data dir outside the repo (docs/production/acceptance-ledger.md).
POCKETQA_ENV=development
# Wallet login in production also needs Hamza's recorded acceptance in ADR 0005 §2.
POCKETQA_WALLET_LOGIN_RISK_ACCEPTED=0
# Evidence storage: local (media directory) or r2.
POCKETQA_STORAGE=local
POCKETQA_R2_ACCOUNT_ID=
POCKETQA_R2_BUCKET=
# Set these two in the host's secret store, never here.
POCKETQA_R2_ACCESS_KEY_ID=
POCKETQA_R2_SECRET_ACCESS_KEY=
# R2 object deletion (quarantine cleanup, sweep, account deletion). Off: deletes stay in the
# outbox and no object is removed. Turn on only with Hamza's explicit approval.
POCKETQA_R2_ALLOW_DELETE=0
# r2 with deletion off only for synthetic, non-production data (objects retained, account deletion refused).
POCKETQA_R2_RETAIN_NONPROD=0
# The shared synthetic demo (preview) only; it pins local auth/storage and no wallet login.
POCKETQA_SHARED_DEMO=0
