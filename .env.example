# Copy to .env.local (gitignored). Never commit real values.
# The API refuses to start unless HOST is a loopback address (127.0.0.1 or ::1).
POCKETQA_API_HOST=127.0.0.1
POCKETQA_API_PORT=8787
# The API refuses to start if this directory is inside the repo but not ignored by git.
POCKETQA_DATA_DIR=apps/api/.data
# Devnet only. The API refuses chain features unless the RPC genesis hash is devnet's.
POCKETQA_SOLANA_RPC_URL=https://api.devnet.solana.com
# Domain shown in the Sign-In With Solana message.
POCKETQA_SIWS_DOMAIN=pocketqa.local
# Optional AI provider. Leave it empty and the app shows "Analysis unavailable".
POCKETQA_AI_PROVIDER=
