rules_version = '2';
// Pocket QA (docs/plans/firebase-vercel-refactor.md §4): clients never read or write Firestore.
// The API reaches it with the Admin SDK (which bypasses rules) and enforces authorisation itself.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
