{
  "name": "@pocket-qa/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8090",
    "build:web": "expo export --platform web --output-dir dist-web",
    "android": "expo run:android",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest --ci",
    "e2e:web": "playwright test"
  },
  "dependencies": {
    "@expo-google-fonts/dm-mono": "0.4.2",
    "@expo-google-fonts/instrument-sans": "0.4.2",
    "@expo-google-fonts/red-hat-display": "0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "@pocket-qa/contracts": "workspace:*",
    "@pocket-qa/domain": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@scure/base": "2.4.0",
    "@solana-mobile/mobile-wallet-adapter-protocol": "2.3.0",
    "@solana/wallet-standard-features": "1.5.0",
    "@tanstack/react-query": "5.104.1",
    "@wallet-standard/app": "1.1.1",
    "expo": "~57.0.26",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "firebase": "12.19.0",
    "lucide-react-native": "1.50.0",
    "pocketqa-screen-capture": "workspace:*",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.3",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "24.19.1",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-worklets/jest/resolver.js",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/",
      "/e2e-firebase/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|lucide-react-native|@noble/.*|@scure/.*|@pocket-qa/.*))"
    ]
  }
}
