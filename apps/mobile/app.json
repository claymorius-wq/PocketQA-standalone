{
  "expo": {
    "name": "Pocket QA",
    "slug": "pocket-qa",
    "scheme": "pocketqa",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.reshareai.pocketqa"
    },
    "ios": {
      "bundleIdentifier": "com.reshareai.pocketqa",
      "supportsTablet": false,
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.reshareai.pocketqa"]
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router", "expo-status-bar", "expo-secure-store", "expo-video", "expo-image", "expo-font", "./plugins/withLocalhostCleartext", "./plugins/withBroadcastExtension"]
  }
}
