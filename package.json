{
  "name": "pocket-qa",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.3.0 <25"
  },
  "scripts": {
    "check:secrets": "node scripts/check-secrets.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "node --test \"scripts/*.test.mjs\" && pnpm -r --if-present test",
    "verify": "pnpm check:secrets && node scripts/preview/assert-no-secrets.mjs --repo && pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "typescript-eslint": "8.71.0",
    "@eslint/js": "10.0.1",
    "typescript": "~6.0.3"
  }
}
